{
  "name": "popecoin_vesting",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Antony Pinedo <antonyomarpinedopuerta@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "fastestsmallesttextencoderdecoder": "1.0.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:safe": "python3 scripts/build-release.py",
    "test:rust": "npm run build:safe && cargo test --locked",
    "check": "npm run build:safe && cargo test --locked && tsc --noEmit && npm run test:client && npm run verify:release",
    "test:client": "node --require ts-node/register tests/run.ts",
    "verify:release": "ts-node scripts/verify-mainnet-release.ts",
    "app": "ts-node app/server.ts",
    "build:rehearsal": "python3 scripts/build-rehearsal.py",
    "build:devnet": "python3 scripts/build-devnet.py",
    "devnet:snapshot": "ts-node scripts/devnet-snapshot.ts",
    "plan:production": "ts-node scripts/production-plan.ts",
    "devnet:program": "ts-node scripts/devnet-program.ts",
    "check:rc": "python3 scripts/check-rc.py",
    "verify:reproducible": "python3 scripts/reproduce-release.py",
    "verify:rc": "python3 scripts/package-rc.py --verify-only",
    "package:rc": "python3 scripts/package-rc.py",
    "verify:package": "python3 scripts/package-rc.py --verify-archive",
    "check:clean": "python3 scripts/check-clean.py",
    "audit:dependencies": "python3 scripts/audit-dependencies.py",
    "check:metadata": "python3 scripts/check-metadata.py",
    "check:metadata:remote": "python3 scripts/check-metadata.py --remote",
    "rehearse:devnet": "ts-node scripts/rehearse-devnet.ts",
    "prepare:audit": "python3 scripts/prepare-audit.py",
    "collect:ci": "python3 scripts/collect-ci.py",
    "prepare:rehearsal": "ts-node scripts/prepare-rehearsal.ts",
    "prepare:rehearsal-tx": "ts-node scripts/rehearsal-one-tx.ts",
    "prepare:metadata": "ts-node scripts/prepare-metadata.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "resolutions": {
    "uuid": "11.1.1",
    "toml": "4.2.0",
    "bigint-buffer": "file:vendor/bigint-buffer"
  },
  "packageManager": "yarn@1.22.22"
}
